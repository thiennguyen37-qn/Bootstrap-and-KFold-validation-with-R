{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,

  // Tắt chẩn đoán style (lintr) cho R — chỉ là gợi ý thẩm mỹ, không phải lỗi.
  "r.lsp.diagnostics": false,

  "files.associations": {
    "*.Rnw": "latex"
  },

  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.recipe.default": "lastUsed",

  "latex-workshop.latex.tools": [
    {
      "name": "knitr",
      "command": "Rscript",
      "args": ["-e", "knitr::knit('%DOCFILE_EXT%')"]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      // Script tự dò xelatex trong TinyTeX và chạy lại khi crash, nên không phụ
      // thuộc PATH. Chỉ build tieu_luan.Rnw.
      "name": "build-tieu-luan",
      "command": "Rscript",
      "args": ["build_tieu_luan.R"]
    }
  ],

  // Recipe đầu là recipe dùng được trên máy hiện tại: "xelatex" trần ở recipe
  // thứ hai đang trỏ vào bản MiKTeX hỏng, còn script thì tự tìm TinyTeX.
  "latex-workshop.latex.recipes": [
    {
      "name": "tieu_luan: knitr -> xelatex (co retry)",
      "tools": ["build-tieu-luan"]
    },
    {
      "name": "knitr -> xelatex x3",
      "tools": ["knitr", "xelatex", "xelatex", "xelatex"]
    }
  ]
}
