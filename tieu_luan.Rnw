# In một data.frame thành bảng LaTeX thật (đánh số "Bảng N", có caption),
# thay vì để print() chụp lại thành text console như mặc định của knitr.
# [H] giữ bảng đúng tại chỗ gọi; \shrinktofit co bảng nhiều cột (tên biến
# dài, nhiều chỉ số) vừa khít trang thay vì tràn lề.
kbl_tab <- function(df, caption, label, col.names = NA, row.names = FALSE) {
  tab <- paste(knitr::kable(df, format = "latex", booktabs = TRUE,
                            col.names = col.names, row.names = row.names),
              collapse = "\n")
  cat(sprintf(
    "\\begin{table}[H]\n\\centering\n\\caption{%s}\n\\label{tab:%s}\n\\shrinktofit{%%\n%s\n}\n\\end{table}\n",
    caption, label, tab))
}
